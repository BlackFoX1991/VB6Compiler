<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />

  <PropertyGroup>
    <VB6Project Condition="'$(VB6Project)' == '' and '$(VB6ProjectGroup)' == ''">$(MSBuildProjectDirectory)\$(MSBuildProjectName).vbp</VB6Project>
    <VB6ProjectFullPath Condition="'$(VB6Project)' != ''">$([System.IO.Path]::GetFullPath('$(VB6Project)'))</VB6ProjectFullPath>
    <VB6ProjectDirectory Condition="'$(VB6ProjectFullPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(VB6ProjectFullPath)'))</VB6ProjectDirectory>
    <VB6ProjectGroupFullPath Condition="'$(VB6ProjectGroup)' != ''">$([System.IO.Path]::GetFullPath('$(VB6ProjectGroup)'))</VB6ProjectGroupFullPath>
    <VB6ProjectGroupDirectory Condition="'$(VB6ProjectGroupFullPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(VB6ProjectGroupFullPath)'))</VB6ProjectGroupDirectory>
    <VB6CompilerOutput Condition="'$(VB6Project)' != '' and '$(VB6CompilerOutput)' == ''">$(TargetDir)$(AssemblyName).dll</VB6CompilerOutput>
    <VB6CompilerOutputFullPath Condition="'$(VB6CompilerOutput)' != ''">$([System.IO.Path]::GetFullPath('$(VB6CompilerOutput)'))</VB6CompilerOutputFullPath>
    <VB6CompilerOutputDirectory Condition="'$(VB6CompilerOutputFullPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(VB6CompilerOutputFullPath)'))</VB6CompilerOutputDirectory>
    <VB6CompilerRuntimeOutput Condition="'$(VB6CompilerOutputDirectory)' != ''">$(VB6CompilerOutputDirectory)\VB6.Runtime.dll</VB6CompilerRuntimeOutput>
    <VB6CompilerComHostOutput Condition="('$(VB6EnableComHosting)' == 'true' or '$(VB6EnableComManifest)' == 'true') and '$(VB6CompilerOutputFullPath)' != ''">$(VB6CompilerOutputDirectory)\$([System.IO.Path]::GetFileNameWithoutExtension('$(VB6CompilerOutputFullPath)')).comhost.dll</VB6CompilerComHostOutput>
    <VB6CompilerComHostArgument Condition="'$(VB6EnableComHosting)' == 'true'"> --com-host</VB6CompilerComHostArgument>
    <VB6CompilerComManifestOutput Condition="'$(VB6EnableComManifest)' == 'true' and '$(VB6CompilerOutputFullPath)' != ''">$(VB6CompilerOutputDirectory)\$([System.IO.Path]::GetFileNameWithoutExtension('$(VB6CompilerOutputFullPath)')).manifest</VB6CompilerComManifestOutput>
    <VB6CompilerComManifestArgument Condition="'$(VB6EnableComManifest)' == 'true'"> --com-manifest</VB6CompilerComManifestArgument>
    <VB6CompilerGroupOutputDirectory Condition="'$(VB6CompilerGroupOutputDirectory)' == '' and '$(TargetDir)' != ''">$(TargetDir)</VB6CompilerGroupOutputDirectory>
    <VB6CompilerGroupOutputDirectory Condition="'$(VB6CompilerGroupOutputDirectory)' == '' and '$(OutputPath)' != ''">$(MSBuildProjectDirectory)\$(OutputPath)</VB6CompilerGroupOutputDirectory>
    <VB6CompilerGroupOutputDirectory Condition="'$(VB6CompilerGroupOutputDirectory)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)</VB6CompilerGroupOutputDirectory>
    <VB6CompilerGroupOutputDirectoryFullPath Condition="'$(VB6CompilerGroupOutputDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(VB6CompilerGroupOutputDirectory)'))</VB6CompilerGroupOutputDirectoryFullPath>
    <VB6CompilerGroupOutputDirectoryArgument Condition="'$(VB6CompilerGroupOutputDirectoryFullPath)' != ''">$([System.String]::Copy('$(VB6CompilerGroupOutputDirectoryFullPath)').TrimEnd('\'))</VB6CompilerGroupOutputDirectoryArgument>
    <VB6CompilerGroupStamp Condition="'$(VB6ProjectGroup)' != '' and '$(BaseIntermediateOutputPath)' != ''">$([System.IO.Path]::Combine('$(BaseIntermediateOutputPath)', '$(Configuration)', 'VB6GroupCompile.stamp'))</VB6CompilerGroupStamp>
    <VB6CompilerGroupStamp Condition="'$(VB6ProjectGroup)' != '' and '$(VB6CompilerGroupStamp)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\VB6GroupCompile.stamp</VB6CompilerGroupStamp>
    <VB6CompilerGroupManifest Condition="'$(VB6ProjectGroup)' != '' and '$(VB6CompilerGroupStamp)' != ''">$(VB6CompilerGroupStamp).outputs</VB6CompilerGroupManifest>
    <VB6CompilerStamp Condition="'$(VB6Project)' != '' and '$(BaseIntermediateOutputPath)' != ''">$([System.IO.Path]::Combine('$(BaseIntermediateOutputPath)', '$(Configuration)', 'VB6Compile.stamp'))</VB6CompilerStamp>
    <VB6CompilerStamp Condition="'$(VB6Project)' != '' and '$(VB6CompilerStamp)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\VB6Compile.stamp</VB6CompilerStamp>
    <VB6CompilerManifest Condition="'$(VB6Project)' != '' and '$(VB6CompilerStamp)' != ''">$(VB6CompilerStamp).outputs</VB6CompilerManifest>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(VB6ProjectFullPath)')">
    <None Include="$(VB6ProjectFullPath)" Visible="false" />
    <VB6CompilerInput Include="$(VB6ProjectFullPath)" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.bas" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.cls" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.ctl" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.dob" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.dsr" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.frm" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.frx" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.pag" />
    <VB6CompilerInput Include="$(VB6ProjectDirectory)\**\*.res" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(VB6ProjectGroupFullPath)')">
    <None Include="$(VB6ProjectGroupFullPath)" Visible="false" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupFullPath)" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.vbp" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.bas" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.cls" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.ctl" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.dob" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.dsr" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.frm" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.frx" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.pag" />
    <VB6CompilerGroupInput Include="$(VB6ProjectGroupDirectory)\**\*.res" />
  </ItemGroup>

  <Target
    Name="ValidateVB6CompilerInput"
    BeforeTargets="Build">
    <Error
      Condition="'$(VB6Project)' != '' and '$(VB6ProjectGroup)' != ''"
      Text="VB6.Compiler.Sdk requires exactly one of VB6Project or VB6ProjectGroup; both were specified." />
    <Error
      Condition="'$(VB6ProjectGroup)' == '' and !Exists('$(VB6ProjectFullPath)')"
      Text="VB6 project file was not found: $(VB6ProjectFullPath). Set VB6Project to an existing .vbp file." />
    <Error
      Condition="'$(VB6ProjectGroup)' != '' and !Exists('$(VB6ProjectGroupFullPath)')"
      Text="VB6 project group was not found: $(VB6ProjectGroupFullPath). Set VB6ProjectGroup to an existing .vbg file." />
  </Target>

  <Target
    Name="ValidateVB6CompilerGroupOutputs"
    BeforeTargets="CompileVB6ProjectGroup"
    Condition="'$(VB6ProjectGroup)' != '' and Exists('$(VB6CompilerGroupStamp)') and Exists('$(VB6CompilerGroupManifest)')">
    <ReadLinesFromFile File="$(VB6CompilerGroupManifest)">
      <Output TaskParameter="Lines" ItemName="_VB6CompilerGroupExpectedOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_VB6CompilerGroupMissingOutput Include="@(_VB6CompilerGroupExpectedOutput)" Condition="!Exists('%(_VB6CompilerGroupExpectedOutput.Identity)')" />
    </ItemGroup>
    <Delete
      Files="$(VB6CompilerGroupStamp)"
      Condition="'@(_VB6CompilerGroupMissingOutput)' != ''" />
  </Target>

  <Target
    Name="ValidateVB6CompilerOutputs"
    BeforeTargets="CompileVB6Project"
    Condition="'$(VB6ProjectGroup)' == '' and '$(VB6Project)' != '' and Exists('$(VB6CompilerStamp)') and Exists('$(VB6CompilerManifest)')">
    <ReadLinesFromFile File="$(VB6CompilerManifest)">
      <Output TaskParameter="Lines" ItemName="_VB6CompilerExpectedOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_VB6CompilerMissingOutput Include="@(_VB6CompilerExpectedOutput)" Condition="!Exists('%(_VB6CompilerExpectedOutput.Identity)')" />
    </ItemGroup>
    <Delete
      Files="$(VB6CompilerStamp)"
      Condition="'@(_VB6CompilerMissingOutput)' != ''" />
  </Target>

  <Target
    Name="CompileVB6Project"
    BeforeTargets="Build"
    Condition="'$(VB6ProjectGroup)' == '' and Exists('$(VB6ProjectFullPath)')"
    Inputs="@(VB6CompilerInput)"
    Outputs="$(VB6CompilerStamp);$(VB6CompilerManifest)">
    <MakeDir Directories="$(TargetDir)" />
    <MakeDir Directories="$(VB6CompilerOutputDirectory)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(VB6CompilerPath)&quot; &quot;$(VB6ProjectFullPath)&quot; --emit-assembly &quot;$(VB6CompilerOutputFullPath)&quot;$(VB6CompilerComHostArgument)$(VB6CompilerComManifestArgument)" />
    <ItemGroup>
      <_VB6CompilerGeneratedOutput Include="$(VB6CompilerOutputFullPath)" />
      <_VB6CompilerGeneratedOutput Include="$([System.IO.Path]::ChangeExtension('$(VB6CompilerOutputFullPath)', 'pdb'))" />
      <_VB6CompilerGeneratedOutput Include="$([System.IO.Path]::ChangeExtension('$(VB6CompilerOutputFullPath)', 'runtimeconfig.json'))" />
      <_VB6CompilerGeneratedOutput Include="$(VB6CompilerRuntimeOutput)" Condition="'$(VB6CompilerRuntimeOutput)' != ''" />
      <_VB6CompilerGeneratedOutput Include="$(VB6CompilerComHostOutput)" Condition="'$(VB6CompilerComHostOutput)' != ''" />
      <_VB6CompilerGeneratedOutput Include="$(VB6CompilerComManifestOutput)" Condition="'$(VB6CompilerComManifestOutput)' != ''" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(VB6CompilerManifest)"
      Lines="@(_VB6CompilerGeneratedOutput)"
      Overwrite="true"
      Encoding="UTF-8" />
    <Touch Files="$(VB6CompilerStamp)" AlwaysCreate="true" />
  </Target>

  <Target
    Name="CompileVB6ProjectGroup"
    BeforeTargets="Build"
    Condition="'$(VB6ProjectGroup)' != '' and Exists('$(VB6ProjectGroupFullPath)')"
    Inputs="@(VB6CompilerGroupInput)"
    Outputs="$(VB6CompilerGroupStamp);$(VB6CompilerGroupManifest)">
    <ReadLinesFromFile
      File="$(VB6CompilerGroupManifest)"
      Condition="Exists('$(VB6CompilerGroupManifest)')">
      <Output TaskParameter="Lines" ItemName="_VB6CompilerGroupPreviousOutput" />
    </ReadLinesFromFile>
    <Delete
      Files="@(_VB6CompilerGroupPreviousOutput)"
      Condition="'@(_VB6CompilerGroupPreviousOutput)' != ''" />
    <MakeDir Directories="$(TargetDir)" Condition="'$(TargetDir)' != ''" />
    <MakeDir Directories="$(VB6CompilerGroupOutputDirectoryFullPath)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(VB6CompilerPath)&quot; &quot;$(VB6ProjectGroupFullPath)&quot; --emit-assembly &quot;$(VB6CompilerGroupOutputDirectoryArgument)&quot;$(VB6CompilerComHostArgument)$(VB6CompilerComManifestArgument)" />
    <ItemGroup>
      <_VB6CompilerGroupGeneratedOutput Include="$(VB6CompilerGroupOutputDirectoryFullPath)\*.dll" />
      <_VB6CompilerGroupGeneratedOutput Include="$(VB6CompilerGroupOutputDirectoryFullPath)\*.exe" />
      <_VB6CompilerGroupGeneratedOutput Include="$(VB6CompilerGroupOutputDirectoryFullPath)\*.json" />
      <_VB6CompilerGroupGeneratedOutput Include="$(VB6CompilerGroupOutputDirectoryFullPath)\*.pdb" />
      <_VB6CompilerGroupGeneratedOutput Include="$(VB6CompilerGroupOutputDirectoryFullPath)\*.manifest" />
    </ItemGroup>
    <ItemGroup>
      <_VB6CompilerGroupStaleOutput Include="@(_VB6CompilerGroupPreviousOutput)" />
      <_VB6CompilerGroupStaleOutput Remove="@(_VB6CompilerGroupGeneratedOutput)" />
    </ItemGroup>
    <Delete Files="@(_VB6CompilerGroupStaleOutput)" />
    <WriteLinesToFile
      File="$(VB6CompilerGroupManifest)"
      Lines="@(_VB6CompilerGroupGeneratedOutput)"
      Overwrite="true"
      Encoding="UTF-8" />
    <Touch Files="$(VB6CompilerGroupStamp)" AlwaysCreate="true" />
  </Target>
</Project>
